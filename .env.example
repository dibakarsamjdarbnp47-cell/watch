# Server Port (Automatically set by HostyCare / cPanel Node.js Selector, defaults to 3000)
PORT=3000
NODE_ENV=production

# Optional custom path for SQLite database file (defaults to ./data/wdh_ecommerce.db)
DB_PATH=

# Optional: Google Gemini API key for AI MLM Growth Coach and Strategic Advisory
GEMINI_API_KEY=

# Optional: Razorpay Payment Gateway (Server-side keys for Online Payment Checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
